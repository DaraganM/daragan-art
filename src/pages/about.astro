---
import Base from "../layouts/Base.astro";
import works from "../data/works.json";
import profile from "../data/profile.json";

const portrait = works.find((w) => w.slug === "crossbow-ranger");
const links = [
  { label: "GitHub", href: profile.github, note: "code and analysis projects" },
  { label: "Source code of this site", href: profile.repo, note: "Astro on Cloudflare, one Worker" },
  { label: "LinkedIn", href: profile.linkedin, note: "professional profile" },
].filter((link) => link.href);
---
<Base
  title="About | Daragan"
  description="Mykhailo Daragan is an artist and astrophysics student. Characters, machines, cities and imagined worlds, drawn with attention to proportion, perspective and light."
>
  <div class="wrap">
    <section class="profile">
      <div class="profile-text">
        <h1>About</h1>
        <p class="lead">An artist with a physicist's eye.</p>
        <p>
          I graduated in physics and astronomy from V. N. Karazin Kharkiv National
          University and now study astrophysics at the University of Bonn.
        </p>
        <p>
          I draw the way I measure: I check the proportions, follow the light, then
          bring in the imagination. My work moves between characters, machines,
          architecture and urban sketches, combining observation with invented worlds.
        </p>
        <p>I work with clients worldwide and speak English, German, Ukrainian and Russian.</p>
        <div class="profile-actions">
          <a class="btn" href="/commissions/">Request a commission →</a>
          <a class="text-link" href="/work/">See the work →</a>
        </div>
        <h2>Elsewhere</h2>
        <ul class="profile-links">
          {links.map((link) => (
            <li>
              <a class="text-link" href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>
              <span>{link.note}</span>
            </li>
          ))}
        </ul>
      </div>
      <figure class="profile-art">
        <img
          src={`/works/${portrait.slug}-${portrait.widths.at(-1)}.webp`}
          srcset={portrait.widths.map((x) => `/works/${portrait.slug}-${x}.webp ${x}w`).join(", ")}
          sizes="(min-width: 48rem) 30vw, 100vw"
          width={portrait.width}
          height={portrait.height}
          alt={portrait.alt}
          decoding="async"
        />
      </figure>
    </section>
  </div>
</Base>
